{
  "private": true,
  "name": "timetap",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel ngrok",
    "run:android": "expo run:android",
    "go:android": "expo start --android --go",
    "run:ios": "expo run:ios",
    "go:ios": "expo start --ios --go",
    "lint": "expo lint",
    "check": "expo lint . && prettier . --check",
    "check:fix": "expo lint . --fix && prettier . --write",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli .expo/ dist/",
    "db:generate": "drizzle-kit generate",
    "deps:update": "taze",
    "deps:upgrade": "taze -w"
  },
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.75.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.14.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "del-cli": "^8.0.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "eas-cli": "^27.10.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "taze": "^21.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.21.0"
}
